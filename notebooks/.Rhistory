library(tidyverse)
library(lfe)
library(fixest)
library(stargazer)
library(knitr)
library(gridExtra)
theme_set(theme_minimal(base_size = 12))
# load merged panel (same path as RQ1 / RQ2)
df <- read_csv("../data/processed/merged_voting_unemployment_complete.csv", show_col_types = FALSE)
